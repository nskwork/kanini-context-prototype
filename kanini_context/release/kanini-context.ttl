    rdfs:comment "The authority that issued a rule (rule.authority_id) (1:n; stored as column)" ;
    rdfs:domain kc:Authority ;
    rdfs:range kc:Rule .

kc:supersedes a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "A newer document replaces an older one (1:1; stored as edge)" ;
    rdfs:domain kc:Authority ;
    rdfs:range kc:Authority .

kc:valueSetCanonicalUrl a owl:DatatypeProperty ;
    rdfs:label "canonical url" ;
    rdfs:domain kc:ValueSet ;
    rdfs:range xsd:string .

