@prefix kc: <https://kanini.com/ontology/kanini-context#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kanini.com/ontology/kanini-context> a owl:Ontology ;
    rdfs:label "Kanini Context ontology" ;
    owl:versionInfo "prototype 1.0, from schema specification v1.5" .

kc:AppealWindow a owl:Class ;
    rdfs:comment "aspect: appeal; default effect: floor" ;
    rdfs:subClassOf kc:Obligation .

kc:ApprovalRequired a owl:Class ;
    rdfs:comment "aspect: approval; default effect: additive" ;
    rdfs:subClassOf kc:Rule .

kc:BillingArticle a owl:Class ;
    rdfs:label "billing article" ;
    rdfs:subClassOf kc:Authority .

kc:ClearinghouseEndpoint a owl:Class ;
    rdfs:label "clearinghouse" ;
    rdfs:subClassOf kc:Endpoint .

kc:CoverageCriteria a owl:Class ;
    rdfs:comment "aspect: coverage; default effect: additive" ;
    rdfs:subClassOf kc:Rule .

kc:CrdEndpoint a owl:Class ;
    rdfs:label "crd" ;
    rdfs:subClassOf kc:Endpoint .

kc:DecisionTimeframe a owl:Class ;
    rdfs:comment "aspect: timeframe; default effect: ceiling" ;
    rdfs:subClassOf kc:Obligation .

kc:DocumentationRequirement a owl:Class ;
    rdfs:comment "aspect: documentation; default effect: additive" ;
    rdfs:subClassOf kc:Rule .

kc:DtrEndpoint a owl:Class ;
    rdfs:label "dtr" ;
    rdfs:subClassOf kc:Endpoint .

kc:EmployerGroupProgram a owl:Class ;
    rdfs:label "employer group" ;
    rdfs:subClassOf kc:Program .

kc:ExchangeProgram a owl:Class ;
    rdfs:label "exchange" ;
    rdfs:subClassOf kc:Program .

kc:Exemption a owl:Class ;
    rdfs:comment "aspect: approval; default effect: override" ;
    rdfs:subClassOf kc:Rule .

kc:FaxEndpoint a owl:Class ;
    rdfs:label "fax" ;
    rdfs:subClassOf kc:Endpoint .

kc:Guideline a owl:Class ;
    rdfs:label "guideline" ;
    rdfs:subClassOf kc:Authority .

kc:Lcd a owl:Class ;
    rdfs:label "lcd" ;
    rdfs:subClassOf kc:Authority .

kc:LibraryKnowledgeArtifact a owl:Class ;
    rdfs:label "library" ;
    rdfs:subClassOf kc:KnowledgeArtifact .

kc:MedicaidFfsProgram a owl:Class ;
    rdfs:label "medicaid ffs" ;
    rdfs:subClassOf kc:Program .

kc:MedicaidManagedCareProgram a owl:Class ;
    rdfs:label "medicaid managed care" ;
    rdfs:subClassOf kc:Program .

kc:MedicareAdvantageProgram a owl:Class ;
    rdfs:label "medicare advantage" ;
