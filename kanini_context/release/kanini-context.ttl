    rdfs:comment "A state sits in a Medicare contractor region (n:m; stored as edge)" ;
    rdfs:domain kc:Jurisdiction ;
    rdfs:range kc:Jurisdiction .

kc:Obligation a owl:Class ;
    rdfs:comment "aspect: obligation; default effect: ceiling" ;
    rdfs:subClassOf kc:Rule .

kc:Concept a owl:Class ;
    rdfs:label "concept" ;
    rdfs:comment "A plain clinical idea, used where codes are licensed or a source names a group" ;
    rdfs:subClassOf kc:TerminologyItem .

kc:TerminologyItem a owl:Class ;
    rdfs:label "terminology item" ;
    rdfs:comment "A code, group of codes or clinical idea" .

kc:CoverageItem a owl:Class ;
    rdfs:label "coverage item" ;
    rdfs:comment "Something that defines who pays" .

kc:Payer a owl:Class ;
    rdfs:label "payer" ;
    rdfs:comment "An insurer or government payer" ;
    rdfs:subClassOf kc:CoverageItem ;
    kc:nearestFhirResource "Organization" .

kc:Snapshot a owl:Class ;
    rdfs:label "snapshot" ;
    rdfs:comment "An exact captured copy of a document (kc_core.snapshot)" ;
    kc:nearestFhirResource "Binary" .

kc:ValueSet a owl:Class ;
    rdfs:label "value set" ;
    rdfs:comment "A named group of codes" ;
    rdfs:subClassOf kc:TerminologyItem ;
    kc:nearestFhirResource "ValueSet" .

kc:DataElement a owl:Class ;
    rdfs:label "data element" ;
    rdfs:comment "A piece of documentation tied to a standard code" ;
    kc:nearestFhirResource "ObservationDefinition" .

kc:Jurisdiction a owl:Class ;
    rdfs:label "jurisdiction" ;
    rdfs:comment "A nation, state, Medicare contractor region or county" ;
    rdfs:subClassOf kc:CoverageItem .

kc:KnowledgeArtifact a owl:Class ;
    rdfs:label "knowledge artifact" ;
    rdfs:comment "An insurer questionnaire or logic library" ;
    kc:nearestFhirResource "Questionnaire" .

kc:Plan a owl:Class ;
    rdfs:label "plan" ;
    rdfs:comment "One plan offered by a payer under a program" ;
    rdfs:subClassOf kc:CoverageItem ;
    kc:nearestFhirResource "InsurancePlan" .

kc:Program a owl:Class ;
    rdfs:label "program" ;
    rdfs:comment "A coverage program such as Medicare Advantage" ;
    rdfs:subClassOf kc:CoverageItem .

kc:Source a owl:Class ;
    rdfs:label "source" ;
    rdfs:comment "Where a document is collected from (kc_core.source)" .

kc:Code a owl:Class ;
    rdfs:label "code" ;
    rdfs:comment "A code from a standard code system, valid for dates" ;
    rdfs:subClassOf kc:TerminologyItem ;
    kc:nearestFhirResource "Coding" .

kc:Endpoint a owl:Class ;
    rdfs:label "endpoint" ;
    rdfs:comment "A way to reach an insurer and whether it works" ;
    kc:nearestFhirResource "Endpoint" .

kc:Authority a owl:Class ;
    rdfs:label "authority" ;
    rdfs:comment "A document or body with standing to set rules" ;
    kc:nearestFhirResource "DocumentReference" .

kc:Rule a owl:Class ;
    rdfs:label "rule" ;
    rdfs:comment "What an authority says about a subject, for a scope and dates (kc_core.rule)" ;
    kc:nearestFhirResource "PlanDefinition" .

