    rdfs:range xsd:string .

kc:authorityTitle a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:domain kc:Authority ;
    rdfs:range xsd:string .

kc:belongsTo a owl:ObjectProperty ;
    rdfs:comment "A code is a member of a value set for a period (n:m; stored as table)" ;
    rdfs:domain kc:Code ;
    rdfs:range kc:ValueSet .

kc:binds a owl:ObjectProperty ;
    rdfs:comment "Which programs, plans and places an authority applies to (n:m; stored as table)" ;
    rdfs:domain kc:Authority ;
