kc:MedicareFfsProgram a owl:Class ;
    rdfs:label "medicare ffs" ;
    rdfs:subClassOf kc:Program .

kc:Ncd a owl:Class ;
    rdfs:label "ncd" ;
    rdfs:subClassOf kc:Authority .

kc:PaProgram a owl:Class ;
    rdfs:label "pa program" ;
    rdfs:subClassOf kc:Authority .

kc:PasEndpoint a owl:Class ;
    rdfs:label "pas" ;
    rdfs:subClassOf kc:Endpoint .

kc:PayerList a owl:Class ;
    rdfs:label "payer list" ;
    rdfs:subClassOf kc:Authority .

kc:PayerPaApiEndpoint a owl:Class ;
    rdfs:label "payer pa api" ;
    rdfs:subClassOf kc:Endpoint .

kc:PayerPolicy a owl:Class ;
    rdfs:label "payer policy" ;
    rdfs:subClassOf kc:Authority .

kc:PhoneEndpoint a owl:Class ;
    rdfs:label "phone" ;
    rdfs:subClassOf kc:Endpoint .

kc:PlanDocument a owl:Class ;
    rdfs:label "plan document" ;
    rdfs:subClassOf kc:Authority .

kc:PortalEndpoint a owl:Class ;
    rdfs:label "portal" ;
    rdfs:subClassOf kc:Endpoint .

kc:QuestionnaireKnowledgeArtifact a owl:Class ;
    rdfs:label "questionnaire" ;
    rdfs:subClassOf kc:KnowledgeArtifact .

kc:Regulation a owl:Class ;
    rdfs:label "regulation" ;
    rdfs:subClassOf kc:Authority .

kc:StateManual a owl:Class ;
    rdfs:label "state manual" ;
    rdfs:subClassOf kc:Authority .

kc:StateRule a owl:Class ;
    rdfs:label "state rule" ;
    rdfs:subClassOf kc:Authority .

kc:Statute a owl:Class ;
    rdfs:label "statute" ;
    rdfs:subClassOf kc:Authority .

kc:Thing a owl:Class ;
    rdfs:label "thing" ;
    rdfs:comment "Anything the pack knows about" .

kc:X12278Endpoint a owl:Class ;
    rdfs:label "x12 278" ;
    rdfs:subClassOf kc:Endpoint .

kc:about a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "What a rule covers (rule.subject_id) (n:1; stored as column)" ;
    rdfs:domain kc:Rule ;
    rdfs:range kc:TerminologyItem .

kc:authorityCitation a owl:DatatypeProperty ;
    rdfs:label "citation" ;
    rdfs:domain kc:Authority ;
