# Copy to .env and fill in. .env is never committed.

# Model (through LiteLLM)
OPENAI_API_KEY=
PROPEL_MODEL=openai/gpt-5-mini
# Reasoning effort for the agent and the comparison (empty: the provider default)
PROPEL_REASONING_EFFORT=low

# PostgreSQL (docker compose up -d db)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=kanini
# Time zone for dates shown to staff (such as when a source was last confirmed)
PGTZ=America/Chicago

# Kanini Context MCP server, as the agent reaches it
KC_MCP_URL=http://127.0.0.1:8765/mcp

# Who approves decisions in the demo
PROPEL_REVIEWER=demo-staff

# Database names (defaults shown; the tests use their own)
# KC_BUILD_DB=kc_build
# KC_CLIENT_DB=kc_client
