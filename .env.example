# Copy to .env and fill in. .env is never committed.

# Model (through LiteLLM). Fill in one provider.
# Azure OpenAI: used when the endpoint and key are both set
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
# Optional: an embedding deployment (such as text-embedding-3-small) for document search; empty uses keyword search
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# OpenAI: used when the Azure settings are empty
OPENAI_API_KEY=
# PROPEL_MODEL=openai/gpt-5-mini
# Reasoning effort for the agent and the comparison (empty: the provider default)
PROPEL_REASONING_EFFORT=low

# PostgreSQL (docker compose up -d db)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=kanini
# Time zone for dates shown to staff (such as when a source was last confirmed)
PGTZ=America/Chicago

# Kanini Context MCP server, as the agent reaches it
KC_MCP_URL=http://127.0.0.1:8765/mcp

# Who approves decisions in the demo
PROPEL_REVIEWER=demo-staff

# Database names (defaults shown; the tests use their own)
# KC_BUILD_DB=kc_build
# KC_CLIENT_DB=kc_client
